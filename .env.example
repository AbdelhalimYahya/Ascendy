# Copy to .env and fill in. Never commit .env.
# Database — free Postgres via Supabase / Neon, or local Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascendy?schema=public"

# Backend
PORT=3000
FRONTEND_URL="http://localhost:4200"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Judge0 — self-hosted Docker OR RapidAPI free quota
# Self-hosted: http://localhost:2358
JUDGE0_URL="http://localhost:2358"
JUDGE0_HOST=""
JUDGE0_KEY=""
JUDGE0_ENABLED="false"

# AI provider (abstracted, swappable — one key is enough for MVP)
AI_PROVIDER="groq"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Storage (avatars/screenshots)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SUPABASE_STORAGE_URL=""

# Frontend (Angular, prefixed NEXT_PUBLIC_ not needed — use environment.ts)
# Vercel: set API_URL to deployed backend, e.g. https://ascendy-api.onrender.com/api
API_URL="http://localhost:3000/api"
